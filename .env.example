# Konfigurasi Firebase Web app (project "rimbanara").
# Salin file ini menjadi `.env`, lalu isi nilainya dari Firebase Console:
# Project settings > General > Your apps > Web app > SDK setup and configuration.
# `.env` di-ignore oleh git; jangan commit nilainya.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Tidak dibaca oleh aplikasi: Analytics di luar ruang lingkup (PRD §3.3).
# Disediakan hanya agar cocok dengan konfigurasi web app di Firebase Console.
VITE_FIREBASE_MEASUREMENT_ID=
