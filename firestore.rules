rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /{col}/{docId} {
      allow read: if col in ['wildlife','forests','articles','quizQuestions']
                  && isSignedIn()
                  && (resource.data.isPublished == true || isAdmin());
      allow write: if col in ['wildlife','forests','articles','quizQuestions'] && isAdmin();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName','email','photoUrl','provider','favorites','bestScores','createdAt','updatedAt'])
        && request.resource.data.provider in ['password','google']
        && request.resource.data.favorites.size() <= 500;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favorites','bestScores','updatedAt'])
        && request.resource.data.favorites.size() <= 500;
      allow delete: if false;
    }

    match /users/{uid}/quizHistory/{entryId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['topic','correctCount','totalQuestions','scorePercent','createdAt'])
        && request.resource.data.topic in ['Semua','Hutan','Satwa']
        && request.resource.data.totalQuestions >= 3
        && request.resource.data.totalQuestions <= 10
        && request.resource.data.correctCount >= 0
        && request.resource.data.correctCount <= request.resource.data.totalQuestions
        && request.resource.data.scorePercent >= 0
        && request.resource.data.scorePercent <= 100
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
